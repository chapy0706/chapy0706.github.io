---
// src/layouts/BaseLayout.astro
import "../styles/mode-tokens.css";
import "../styles/global.css";

import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@config/site";

interface Props {
  title?: string;
  description?: string;
  showHeader?: boolean;
  showFooter?: boolean;
  bodyClass?: string;
}

const currentPathname = Astro.url.pathname;

const {
  title = SITE.title,
  description = SITE.description,
  showHeader = true,
  showFooter = true,
  bodyClass = "",
} = Astro.props as Props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!-- FOUC対策: CSS読み込み前にモードを確定させる -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme');
        document.documentElement.dataset.mode = saved ?? 'unix';
        // JS有効時のみスクロール表示アニメの初期状態を適用（描画前に付与）
        document.documentElement.classList.add('js-anim');
      })();
    </script>

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />

    <!-- iPhone/iPad ホーム画面追加用アイコン -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="まったりダイアリー" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta name="generator" content={Astro.generator} />

    <!-- OS/ブラウザに「暗めテーマ」を示す（フォーム等の見た目が馴染みやすい） -->
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0f0f10" />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />

    <!-- Cloudflare Web Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "1381f7e6b7e041c48f8532fd2c7cb61f"}'></script><!-- End Cloudflare Web Analytics -->
  </head>

  <body class={`flex min-h-screen flex-col antialiased ${bodyClass}`.trim()}>
    <a
      href="#content"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[999] focus:rounded-lg focus:bg-slate-950 focus:px-4 focus:py-2 focus:text-slate-100 focus:shadow-2xl"
    >
      本文へスキップ
    </a>

    {showHeader && <Header currentPathname={currentPathname} />}

    <main id="content" class="flex-1">
      <slot />
    </main>

    {showFooter && <Footer />}

    <!-- スクロールで [data-reveal] 要素をふわっと表示（全ページ共通） -->
    <script is:inline>
      (function () {
        var els = Array.prototype.slice.call(
          document.querySelectorAll('[data-reveal]')
        );
        if (!els.length) return;

        var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          els.forEach(function (el) {
            el.classList.add('is-visible');
          });
          return;
        }

        // 同じ親に並ぶカードは少しずつ遅延させてスタッガー表示にする
        var counts = new Map();
        els.forEach(function (el) {
          var parent = el.parentElement;
          var n = counts.get(parent) || 0;
          if (!el.style.getPropertyValue('--reveal-delay')) {
            el.style.setProperty('--reveal-delay', Math.min(n, 6) * 80 + 'ms');
          }
          counts.set(parent, n + 1);
        });

        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach(function (el) {
          io.observe(el);
        });
      })();
    </script>
  </body>
</html>
