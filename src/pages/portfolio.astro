---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/ui/Section.astro';
import ProjectShowcase from '@components/portfolio/ProjectShowcase.astro';
import { projects } from '@config/projects';
import { Image } from 'astro:assets';

import skillMapImg from '@assets/skill-map.svg';

---

<BaseLayout title="ポートフォリオ - ちゃぴぃのまったりダイアリー">
  <!-- Hero Section -->
  <section class="relative h-[70vh] min-h-[500px] flex items-center overflow-hidden">
    <!-- Background Image with Overlay -->
    <div class="absolute inset-0">
      <Image 
        src={skillMapImg}
        alt="Skill map overview"
        class="w-full h-full object-cover opacity-50"
        width={2070}
        height={1380}
      />
      <div class="absolute inset-0 bg-linear-to-r from-slate-950/90 via-slate-950/75 to-slate-900/60"></div>
    </div>

    <!-- Content -->
    <div class="container mx-auto relative z-10 px-4 sm:px-6 lg:px-8">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center px-4 py-2 mb-6 bg-white/10 text-slate-100 text-sm font-semibold rounded-full shadow-lg">
          <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd" />
          </svg>
          私の制作物一覧
        </div>
        
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-bold text-slate-100 mb-6 leading-tight">
          <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 via-teal-400 to-blue-400">
            ポートフォリオ
          </span>
        </h1>
        
        <p class="text-xl md:text-2xl text-slate-200/80 mb-8 max-w-3xl mx-auto leading-relaxed">
          興味を持った技術を活用して様々な制作物を制作しています。<br>
          Claude Code やCodexなどをメインに活用し、<br>
          AI駆動開発を積極的に取り入れています。
        </p>
      </div>
    </div>
  </section>

  <!-- Projects Section -->
  <Section background="gray" id="projects" class="bg-transparent">
    <div class="text-center mb-16">
      <div class="inline-block px-4 py-2 mb-4 bg-white/10 text-sm font-semibold rounded-full" style="color:var(--text);border:1px solid var(--line);">
        わたしとClaude Code,Codexと作った
      </div>
      <h2 class="text-4xl md:text-5xl font-bold mb-4" style="color:var(--text);">
        最近の <span class="gradient-text">制作物一覧</span>
      </h2>
      <p class="text-xl max-w-3xl mx-auto" style="color:var(--text-muted);">
        実際の画面と一緒に、どんなアプリか・構成や技術・見どころをまとめています。
      </p>
    </div>

    <div class="flex flex-col gap-12">
      {projects.map((project) => (
        <ProjectShowcase project={project} />
      ))}
    </div>
  </Section>

  <!-- CTA Section -->
  <section class="relative py-32 overflow-hidden">
    <!-- Background Image -->
    <div class="absolute inset-0">
      <Image 
        src={skillMapImg}
        alt="Skill map overview"
        class="w-full h-full object-cover opacity-50"
        width={2070}
        height={1380}
      />
      <div class="absolute inset-0 bg-linear-to-r from-slate-950/95 to-slate-900/85"></div>
    </div>

    <!-- Content -->
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-4xl mx-auto text-center text-white">
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6 leading-tight">
          次の作品は <span class="text-transparent bg-clip-text bg-linear-to-r from-blue-400 to-teal-400">絶賛検討中</span>
        </h2>
        <p class="text-xl md:text-2xl text-slate-200 mb-12 max-w-2xl mx-auto leading-relaxed">
          DBの学習となるゲームアプリの開発とか楽しそうだなと思っています。</p>
      </div>
    </div>
  </section>
</BaseLayout>
